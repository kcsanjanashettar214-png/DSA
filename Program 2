#include<stdio.h>
#define MAX 20
void readMatrix(int a[MAX][MAX],int r,int c)
{
    int i,j;
    for(i=0; i<r; i++)
        for(j=0; j<r; j++)
        scanf(" %d", &a[i][j]);
}
void sparse(int a[MAX][MAX], int r, int c)
{
    int s[MAX*MAX] [3];
    int i,j,k=0;
    for(i=0; i<r; i++)
        for(j=0; j<r; j++)
        if(a[i][j] != 0)
        {
            s[k][0] = i;
            s[k][1] = j;
            s[k][2] = a[i][j];
            k++;
        }
        printf("\nRow\tCol\tValue\n");
        for(i=0; i<k; i++)
            printf("%d\t%d\t%d\n", s[i][0], s[i][1], s[i][2]);

    }
    void add(int a[MAX][MAX], int b[MAX][MAX], int r,int c)
    {
        int sum[MAX][MAX];
        int i,j;
        for(i=0; i<r; i++)
            for(j=0; j<r; j++)
            sum[i][j] = a[i][j] + b[i][j];
            printf("\nSparse Representation of Sum: \n");
        sparse(sum,r,c);
    }
    void transpose(int a[MAX][MAX], int r, int c)
    {
        int t[MAX][MAX];
        int i,j;
        for(i=0; i<r; i++)
            for(j=0; j<r; j++)
            t[i][j] = a[i][j];
        printf("\n Sparse Representation of Transpose: \n");
        sparse(t, c, r);
    }
    int main()
    {
        int a[MAX][MAX], b[MAX][MAX];
        int r,c, choice, entered = 0;
        while(1)
        {
            printf("\n ===== SPARSE MATRIX MENU =====\n");
            printf("1. Enter matrices\n");
            printf("2. Transpose\n");
            printf("3. Add\n");
            printf("4. Exit\n");
            printf(" Enter your choice: ");
            scanf(" %d", &choice);
            switch(choice)
            {
            case 1:
                printf("\n Enter rows and columns: ");
                scanf(" %d %d", &r, &c);
                printf("\n Enter elements of Matrix 1: \n");
                readMatrix(a, r, c);
                printf("\n Enter elements of Matrix 2: \n");
                readMatrix(b, r, c);
                printf("\n Sparse Representation of Matrix 1: \n");
                sparse(a, c, r);
                printf("\n Sparse Representation of Matrix 2: \n");
                sparse(b, r, c);
                break;
            case 2:
                printf("\n ---Matrix 1---");
                transpose(a, c, r);
                printf("\n ---Matrix 2---");
                transpose(b, c, r);
                break;
            case 3:
                add(a, b, r, c);
                break;
            case 4:
                return 0;
            }
        }
    }

